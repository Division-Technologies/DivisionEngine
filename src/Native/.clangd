# clangd 設定ファイル
# https://clangd.llvm.org/config

# コンパイルフラグの設定
CompileFlags:
  # compile_commands.jsonが置かれているディレクトリ
  # CMakeがCMAKE_EXPORT_COMPILE_COMMANDS=ONで生成する
  CompilationDatabase: build/clang-debug

# 診断（エラー・警告）の設定
Diagnostics:
  # clang-tidy による静的解析
  ClangTidy:
    # 有効化するチェック項目は .clang-tidy に書く（ディレクトリごとの上書きも .clang-tidy で行う）
    # ここで Add すると、下位ディレクトリの .clang-tidy で外したチェックが clangd では再び有効になる
    # 遅いチェックを除外するフィルターの強さ(チェック自体の厳しさではない)
    # Strict(デフォルト): 遅い可能性のあるチェックを厳しく除外 → 速いチェックのみ残る
    # Loose: 非常に遅いチェックだけ除外
    # None: 除外しない(全チェック実行)
    FastCheckFilter: Strict
