Checks: >
  bugprone-*,
  performance-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  readability-identifier-naming
WarningsAsErrors: '*'
# clang-tidyは絶対パスに対して照合するため、'^'で始めるとどのヘッダにもマッチしない.
HeaderFilterRegex: '(source|include)/'
FormatStyle: file

# 命名規則はGoogle C++ Style Guideに準拠する.
# https://google.github.io/styleguide/cppguide.html#Naming
CheckOptions:
  # ----- 型 -----
  # クラス・構造体・列挙・別名はすべてCamelCase.
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.UnionCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.ConceptCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase

  # ----- 関数 -----
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.MethodCase
    value: CamelCase

  # ----- 名前空間 -----
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

  # ----- 変数 -----
  # ローカル定数(LocalConstant)は意図的に未指定とし、VariableCaseへ委ねる.
  # Googleの「k接頭辞」はプログラム実行中ずっと値が変わらない定数が対象だが、
  # constであるかどうかからは機械的に判定できないため.
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case

  # ----- クラスのデータメンバ -----
  # クラスの非staticデータメンバは末尾にアンダースコアを付ける.
  # structのメンバには付けないが、clang-tidyはclassとstructを区別しないため、
  # public扱いのMemberCaseには接尾辞を指定しない.
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key: readability-identifier-naming.ProtectedMemberCase
    value: lower_case
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: '_'
  - key: readability-identifier-naming.MemberCase
    value: lower_case

  # ----- 定数 -----
  # 値が固定される定数はUPPER_CASE(MAX_FRAME_COUNTなど).
  # Googleはk接頭辞(kMaxFrameCount)を採るが、ここは意図的に外している.
  - key: readability-identifier-naming.ConstexprVariableCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.ClassConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE

  # ----- マクロ -----
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE

  # ----- 例外 -----
  # 標準ライブラリとの結合に必要な名前は規則の対象外とする.
  - key: readability-identifier-naming.TypeAliasIgnoredRegexp
    value: '^(is_transparent)$'
  - key: readability-identifier-naming.MethodIgnoredRegexp
    value: '^(main|begin|end)$'
  - key: readability-identifier-naming.IgnoreMainLikeFunctions
    value: 'true'
