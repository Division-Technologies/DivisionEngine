<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DivisionRuntimeAuthoring Condition="'$(DivisionRuntimeAuthoring)' == ''">true</DivisionRuntimeAuthoring>
    </PropertyGroup>

    <PropertyGroup Condition="'$(DivisionRuntimeAuthoring)' == 'true'">
        <DefineConstants>$(DefineConstants);DIVISION_RUNTIME_AUTHORING</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\DivisionEngine.Authoring\DivisionEngine.Authoring.csproj" Condition="'$(DivisionRuntimeAuthoring)' == 'true'"/>
        <ProjectReference Include="..\DivisionEngine.Generators\DivisionEngine.Generators\DivisionEngine.Generators.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
        <ProjectReference Include="..\DivisionEngine\DivisionEngine.csproj"/>
    </ItemGroup>

</Project>
